# Copy to .env and adjust the values you need. All variables are optional;
# the values below are suitable for local development.
# Variables already set in the environment take precedence over .env.

# --- Django ---
# Required in production: set a long random value. Leave commented out locally
# to use the insecure development key (an empty value would break Django).
# DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Comma-separated lists
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Enable only behind a reverse proxy that terminates HTTPS and sets X-Forwarded-Proto
DJANGO_BEHIND_HTTPS_PROXY=false

# --- PostgreSQL ---
POSTGRES_DB=mtg_ledger
POSTGRES_USER=mtg_ledger
POSTGRES_PASSWORD=mtg_ledger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- CardTrader ---
# Full API token (can also be set per service from the Sync > Settings page)
CARDTRADER_API_TOKEN=

# --- Card recognition from the camera (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Celery (Cardmarket sync worker) ---
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Docker Compose only ---
APP_PORT=8000
GUNICORN_WORKERS=2
REDIS_PORT=6379
